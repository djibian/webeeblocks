#VRML_SIM R2025a utf8

# Isolated native feature probe. No Crazyflie, activity, world mutation or oracle.
WorldInfo {
  basicTimeStep 32
  randomSeed 1
  title "WebeeBlocks R2025a pause WWI falsification"
}
Viewpoint {
  position 1 1 2
}
Robot {
  name "Webots Pause WWI Probe"
  supervisor TRUE
  controller "ci_webots_pause_wwi"
  window "ci_webots_pause_wwi"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.15 0.5 0.8 roughness 0.8 }
      geometry Box { size 0.1 0.1 0.1 }
    }
  ]
}
