#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/bitcraze/crazyflie/protos/Crazyflie.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/Floor.proto"

WorldInfo {
  basicTimeStep 32
  randomSeed 1
  optimalThreadCount 1
  title "WebeeBlocks — progression robotique"
}
Viewpoint {
  orientation -0.45 0.47 0.76 1.05
  position -2.4 -2.4 2.2
  follow "Crazyflie WebeeBlocks"
}
TexturedBackground { }
TexturedBackgroundLight { }
Floor { size 4 4 }

# The first progression activity uses these visual-only pads. The target sits
# before the existing red obstacle so several forward distances can satisfy the
# world-state mission without encoding one expected Blockly solution.
DEF SEQUENCE_START_PAD Pose {
  translation 0 0 0.003
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.12 0.38 0.90
        emissiveColor 0.02 0.05 0.14
        roughness 0.55
      }
      geometry Box { size 0.18 0.18 0.006 }
    }
  ]
}
DEF SEQUENCE_TARGET_PAD Pose {
  translation 0.25 0 0.003
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.12 0.72 0.28
        emissiveColor 0.02 0.10 0.03
        roughness 0.55
      }
      geometry Box { size 0.18 0.18 0.006 }
    }
  ]
}

DEF FIRST_OBSTACLE Solid {
  translation 0.45 0 0.55
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.85 0.15 0.1 roughness 0.6 }
      geometry Box { size 0.06 0.12 1.1 }
    }
  ]
  boundingObject Box { size 0.06 0.12 1.1 }
}
DEF SECOND_OBSTACLE Solid {
  translation 0.70 0.30 0.55
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.9 0.55 0.05 roughness 0.6 }
      geometry Box { size 0.06 0.12 1.1 }
    }
  ]
  boundingObject Box { size 0.06 0.12 1.1 }
}

DEF WEBEEBLOCKS_CRAZYFLIE Crazyflie {
  name "Crazyflie WebeeBlocks"
  controller "crazyflie_runtime_v2"
  window "blockly_v2"
  supervisor TRUE
  synchronization TRUE
  extensionSlot [
    # WEBEEBLOCKS_COLOR_LED_DECK_VISUAL_V1_BEGIN
    Pose {
      translation 0 0 0.0066
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.04 0.09 0.05
            roughness 0.62
            metalness 0
          }
          geometry Box {
            size 0.0347 0.0347 0.0015
          }
        }
        Pose {
          translation -0.0135 -0.0135 0.004
          children [
            Shape {
              appearance PBRAppearance { baseColor 0.18 0.18 0.18 roughness 0.35 metalness 0.2 }
              geometry Box { size 0.0022 0.0022 0.0065 }
            }
          ]
        }
        Pose {
          translation -0.0135 0.0135 0.004
          children [
            Shape {
              appearance PBRAppearance { baseColor 0.18 0.18 0.18 roughness 0.35 metalness 0.2 }
              geometry Box { size 0.0022 0.0022 0.0065 }
            }
          ]
        }
        Pose {
          translation 0.0135 -0.0135 0.004
          children [
            Shape {
              appearance PBRAppearance { baseColor 0.18 0.18 0.18 roughness 0.35 metalness 0.2 }
              geometry Box { size 0.0022 0.0022 0.0065 }
            }
          ]
        }
        Pose {
          translation 0.0135 0.0135 0.004
          children [
            Shape {
              appearance PBRAppearance { baseColor 0.18 0.18 0.18 roughness 0.35 metalness 0.2 }
              geometry Box { size 0.0022 0.0022 0.0065 }
            }
          ]
        }
        LED {
          translation 0 0 -0.0058
          name "color_led"
          gradual TRUE
          color [ ]
          children [
            Group {
              children [
                Shape {
                  appearance PBRAppearance {
                    baseColor 0.82 0.84 0.82
                    emissiveColor 0 0 0
                    transparency 0.12
                    roughness 0.25
                    metalness 0
                  }
                  geometry Cylinder {
                    height 0.0101
                    radius 0.01735
                    subdivision 48
                  }
                }
                Shape {
                  appearance PBRAppearance {
                    baseColor 0.10 0.10 0.10
                    emissiveColor 0 0 0
                    transparency 0.78
                    roughness 0.25
                    metalness 0
                  }
                  geometry Cylinder {
                    height 0.012
                    radius 0.022
                    subdivision 48
                  }
                }
                PointLight {
                  attenuation 1 0 300
                  intensity 0.7
                  radius 0.18
                  castShadows FALSE
                }
              ]
            }
          ]
        }
      ]
    }
    # WEBEEBLOCKS_COLOR_LED_DECK_VISUAL_V1_END
    Pose {
      translation 0 0 0.02
      rotation 0 1 0 -1.57079632679
      children [
        DistanceSensor {
          name "range_up"
          lookupTable [
            0 0 0
            2 2000 0
          ]
        }
      ]
    }
  ]
}

Robot {
  name "Progression sequence evaluator"
  controller "progression_sequence_evaluator"
  supervisor TRUE
}
