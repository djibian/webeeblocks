Crazyflie {
  name "Crazyflie WebeeBlocks"
  controller "crazyflie_runtime_v2"
  window "blockly_v2"
  supervisor TRUE
  synchronization TRUE
  extensionSlot [
    # WEBEEBLOCKS_COLOR_LED_DECK_VISUAL_V1_BEGIN
    Pose {
      translation 0 0 0.0066
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.04 0.09 0.05
            roughness 0.62
            metalness 0
          }
          geometry Box {
            size 0.0347 0.0347 0.0015
          }
        }
        Pose {
          translation -0.0135 -0.0135 0.004
          children [
            Shape {
              appearance PBRAppearance { baseColor 0.18 0.18 0.18 roughness 0.35 metalness 0.2 }
              geometry Box { size 0.0022 0.0022 0.0065 }
            }
          ]
        }
        Pose {
          translation -0.0135 0.0135 0.004
          children [
            Shape {
              appearance PBRAppearance { baseColor 0.18 0.18 0.18 roughness 0.35 metalness 0.2 }
              geometry Box { size 0.0022 0.0022 0.0065 }
            }
          ]
        }
        Pose {
          translation 0.0135 -0.0135 0.004
          children [
            Shape {
              appearance PBRAppearance { baseColor 0.18 0.18 0.18 roughness 0.35 metalness 0.2 }
              geometry Box { size 0.0022 0.0022 0.0065 }
            }
          ]
        }
        Pose {
          translation 0.0135 0.0135 0.004
          children [
            Shape {
              appearance PBRAppearance { baseColor 0.18 0.18 0.18 roughness 0.35 metalness 0.2 }
              geometry Box { size 0.0022 0.0022 0.0065 }
            }
          ]
        }
        LED {
          translation 0 0 -0.0058
          name "color_led"
          gradual TRUE
          color [ ]
          children [
            Group {
              children [
                Shape {
                  appearance PBRAppearance {
                    baseColor 0.82 0.84 0.82
                    emissiveColor 0 0 0
                    transparency 0.12
                    roughness 0.25
                    metalness 0
                  }
                  geometry Cylinder {
                    height 0.0101
                    radius 0.01735
                    subdivision 48
                  }
                }
                Shape {
                  appearance PBRAppearance {
                    baseColor 0.10 0.10 0.10
                    emissiveColor 0 0 0
                    transparency 0.78
                    roughness 0.25
                    metalness 0
                  }
                  geometry Cylinder {
                    height 0.012
                    radius 0.022
