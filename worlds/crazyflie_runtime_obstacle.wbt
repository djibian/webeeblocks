DEF OBSTACLE Solid {
  translation 1.25 0 0.70
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.8 0.1 0.1
        roughness 0.6
        metalness 0
      }
      geometry Box {
        size 0.05 0.30 1.40
      }
    }
  ]
  boundingObject Box {
    size 0.05 0.30 1.40
  }
}
DEF CRAZYFLIE Crazyflie {
  name "Crazyflie Runtime"
  synchronization TRUE
  controller "crazyflie_l_course"
  controllerArgs [
    "runtime"
  ]
  window "blockly"
  supervisor TRUE
  extensionSlot [
    Pose {
      translation 0 0 -0.012
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.06 0.28 0.10
            roughness 0.65
            metalness 0
          }
          geometry Box {
            size 0.040 0.040 0.0015
          }
        }
        LED {
          translation 0 0 -0.0013
          name "color_led"
          gradual TRUE
          color [ ]
          children [
            Shape {
              appearance PBRAppearance {
                baseColor 0.03 0.03 0.03
                emissiveColor 0 0 0
                roughness 0.4
                metalness 0
              }
              geometry Box {
                size 0.026 0.026 0.001
              }
            }
          ]
        }
      ]
    }
    Pose {
      translation 0 0 0.02
      rotation 0 1 0 -1.57079632679
      children [
        DistanceSensor {
          name "range_up"
          lookupTable [
            0 0 0
            2 2000 0
          ]
        }
      ]
    }
  ]
}
Robot {
  name "Collision observer"
  controller "crazyflie_collision_observer"
  supervisor TRUE
}
