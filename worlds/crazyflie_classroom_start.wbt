DEF WEBEEBLOCKS_CLASSROOM_START_WORLD WorldInfo {
  basicTimeStep 32
  randomSeed 1
  optimalThreadCount 1
  title "WebeeBlocks — accueil"
}
Viewpoint {
  orientation -0.45 0.47 0.76 1.05
  position -2.4 -2.4 2.2
  follow "Crazyflie WebeeBlocks"
}
TexturedBackground { }
TexturedBackgroundLight { }
Floor { size 4 4 }


