          children [
            Group {
              children [
                Shape {
                  appearance PBRAppearance {
                    baseColor 0.82 0.84 0.82
                    emissiveColor 0 0 0
                    transparency 0.12
                    roughness 0.25
                    metalness 0
                  }
                  geometry Cylinder {
                    height 0.0101
                    radius 0.01735
                    subdivision 48
                  }
                }
                Shape {
                  appearance PBRAppearance {
                    baseColor 0.10 0.10 0.10
                    emissiveColor 0 0 0
