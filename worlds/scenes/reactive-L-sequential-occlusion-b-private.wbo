# A5 PRIVATE two-successive-L native visibility experiment B: not pupil-facing.
# Original R2025a Crazyflie, real solids, no motor program or student mission oracle.
# L1, corridor and terminal screen identical; L2 blocks opposite lateral openings.
# This is a private perception experiment, not a certified pupil mission.
DEF WEBEEBLOCKS_A5_SEQ_OCC_B_SCENE Group {
  children [
    DEF A5_SEQ_L1_POST Solid {
      name "A5_SEQ_L1_POST"
      translation 1.000 -0.300 0.550
      children [ Shape { appearance PBRAppearance { baseColor 0.74 0.20 0.12 roughness 0.6 }
        geometry Box { size 0.080 1.150 1.100 } } ]
      boundingObject Box { size 0.080 1.150 1.100 }
    }
    DEF A5_SEQ_L1_ARM Solid {
      name "A5_SEQ_L1_ARM"
      translation 0.650 0.275 0.550
      children [ Shape { appearance PBRAppearance { baseColor 0.74 0.20 0.12 roughness 0.6 }
        geometry Box { size 0.700 0.080 1.100 } } ]
      boundingObject Box { size 0.700 0.080 1.100 }
    }
    DEF A5_SEQ_L2_POST Solid {
      name "A5_SEQ_L2_POST"
      translation 2.500 -0.450 0.550
      children [ Shape { appearance PBRAppearance { baseColor 0.85 0.43 0.13 roughness 0.6 }
        geometry Box { size 0.080 1.200 1.100 } } ]
      boundingObject Box { size 0.080 1.200 1.100 }
    }
    DEF A5_SEQ_L2_ARM Solid {
      name "A5_SEQ_L2_ARM"
      translation 2.150 -1.050 0.550
      children [ Shape { appearance PBRAppearance { baseColor 0.85 0.43 0.13 roughness 0.6 }
        geometry Box { size 0.700 0.080 1.100 } } ]
      boundingObject Box { size 0.700 0.080 1.100 }
    }
    # Native collision corridor: neither exterior edge permits a 0.09 m craft bypass.
    DEF A5_SEQ_CORRIDOR_POS Solid {
      name "A5_SEQ_CORRIDOR_POS"
      translation 1.500 1.260 0.550
      children [ Shape { appearance PBRAppearance { baseColor 0.30 0.34 0.45 roughness 0.65 }
        geometry Box { size 3.900 0.080 1.100 } } ]
      boundingObject Box { size 3.900 0.080 1.100 }
    }
    DEF A5_SEQ_CORRIDOR_NEG Solid {
      name "A5_SEQ_CORRIDOR_NEG"
      translation 1.500 -1.260 0.550
      children [ Shape { appearance PBRAppearance { baseColor 0.30 0.34 0.45 roughness 0.65 }
        geometry Box { size 3.900 0.080 1.100 } } ]
      boundingObject Box { size 3.900 0.080 1.100 }
    }
    # Common screen bounds front-range reading in the late scene.
    # Neither it nor this entire private experiment awards a pupil verdict.
    DEF A5_SEQ_TERMINAL Solid {
      name "A5_SEQ_TERMINAL"
      translation 3.200 0.000 0.550
      children [ Shape { appearance PBRAppearance { baseColor 0.16 0.62 0.64 roughness 0.65 }
        geometry Box { size 0.080 2.300 1.100 } } ]
      boundingObject Box { size 0.080 2.300 1.100 }
    }
  ]
}
