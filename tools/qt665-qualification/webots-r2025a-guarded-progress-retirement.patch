+// Deletion through a Qt event callback must never destroy the dialog/bar while
+// QProgressDialog::setValue() (or another protected call) is still on the stack.
+// In particular, setValue() itself may call processEvents() before bar->maximum().
+void WbMainWindow::runWorldLoadingProgressOperation(const std::function<void()> &operation) {
+  ++mWorldLoadingProgressOperationDepth;
+  const QPointer<WbMainWindow> window(this);
+  operation();
+  if (!window)
+    return;  // Window shutdown must not access its already destroyed members.
+
+  Q_ASSERT(mWorldLoadingProgressOperationDepth > 0);
+  --mWorldLoadingProgressOperationDepth;
+  if (mWorldLoadingProgressOperationDepth != 0)
+    return;
+
+  // Post deferred deletion ONLY after the outermost call has returned. Posting
+  // deleteLater() inside an inner Qt event loop is not a lifetime barrier.
+  const QList<QProgressDialog *> retired = mRetiredWorldLoadingProgressDialogs;
+  mRetiredWorldLoadingProgressDialogs.clear();
+  for (QProgressDialog *dialog : retired)
+    dialog->deleteLater();
+}
+
+void WbMainWindow::createWorldLoadingProgressDialog() {
+  if (mWorldLoadingProgressDialog || isMinimized())
+    return;
+
+  QProgressDialog *dialog = new QProgressDialog(this);
+  mWorldLoadingProgressDialog = dialog;
+  QPushButton *cancelButton = new QPushButton(dialog);
+
+  runWorldLoadingProgressOperation([this, dialog, cancelButton]() {
+    cancelButton->setText(tr("Cancel"));
+    cancelButton->setAutoDefault(false);
+    cancelButton->setDefault(false);
+    cancelButton->setChecked(false);
+    dialog->setModal(true);
+    dialog->setAutoClose(false);
+    dialog->setWindowTitle(tr("Loading world"));
+    dialog->setLabelText(tr("Opening world file"));
+    dialog->setCancelButton(cancelButton);
+    if (mWorldLoadingProgressDialog != dialog)
+      return;
+    connect(dialog, &QProgressDialog::canceled, WbApplication::instance(), &WbApplication::setWorldLoadingCanceled);
+
+    if (mWorldLoadingProgressDialog != dialog)
+      return;
+    dialog->show();
+    if (mWorldLoadingProgressDialog != dialog)
+      return;
+    WbGuiApplication::setWindowsDarkMode(dialog);
+    if (mWorldLoadingProgressDialog != dialog)
+      return;
+    dialog->setValue(0);
+    if (mWorldLoadingProgressDialog == dialog)
+      QApplication::processEvents();
+  });
+}
+
+void WbMainWindow::deleteWorldLoadingProgressDialog() {
+  QProgressDialog *dialog = mWorldLoadingProgressDialog;
+  if (!dialog)
+    return;
+
+  // Detach BEFORE any Qt operation which might dispatch more signals.
+  mWorldLoadingProgressDialog = NULL;
+  mRetiredWorldLoadingProgressDialogs.append(dialog);
+  runWorldLoadingProgressOperation([dialog]() {
+    QObject::disconnect(dialog, &QProgressDialog::canceled, WbApplication::instance(),
+               &WbApplication::setWorldLoadingCanceled);
+    dialog->hide();  // No close()/cancel() signal and no synchronous delete.
+  });
+}
+
+void WbMainWindow::setWorldLoadingProgress(const int progress) {
+  QProgressDialog *dialog = mWorldLoadingProgressDialog;
+  if (!dialog)
+    return;
+  runWorldLoadingProgressOperation([this, dialog, progress]() {
+    dialog->setValue(progress);
+    if (mWorldLoadingProgressDialog == dialog)
+      QApplication::processEvents();
+  });
+}
+
+void WbMainWindow::setWorldLoadingStatus(const QString &status) {
+  QProgressDialog *dialog = mWorldLoadingProgressDialog;
+  if (!dialog)
+    return;
+  runWorldLoadingProgressOperation([this, dialog, status]() {
+    dialog->setLabelText(status);
+    if (mWorldLoadingProgressDialog == dialog)
+      QApplication::processEvents();
+  });
+}
 
