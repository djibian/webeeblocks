#VRML_SIM R2025a utf8

# Qualification-only Webots shell.  The real execution path is the trusted
# physical host; this world exists only to host the Robot Window and Runtime v2
# controller without depending on optional Webots project assets.
WorldInfo {
  basicTimeStep 32
  randomSeed 1
  optimalThreadCount 1
  title "WebeeBlocks — qualification physique"
}
Viewpoint {
  orientation -0.45 0.47 0.76 1.05
  position -1.2 -1.2 1.0
  follow "Crazyflie WebeeBlocks"
}
Background {
  skyColor [ 0.75 0.83 0.92 ]
}
DirectionalLight {
  direction -0.4 -0.5 -1
  intensity 1.5
}
Solid {
  translation 0 0 -0.025
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.65 0.68 0.72
        roughness 0.8
      }
      geometry Box { size 4 4 0.05 }
    }
  ]
  boundingObject Box { size 4 4 0.05 }
}

Robot {
  translation 0 0 0.015
  name "Crazyflie WebeeBlocks"
  controller "crazyflie_runtime_v2"
  window "blockly_v2"
  supervisor TRUE
  synchronization TRUE
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.08 0.08 0.08
        roughness 0.5
      }
      geometry Cylinder {
        height 0.03
        radius 0.05
      }
    }
    DistanceSensor {
      rotation 0 0 1 -1.57079632679
      name "range_right"
      lookupTable [
        0 0 0
        2 2000 0
      ]
    }
    DistanceSensor {
      rotation 0 0 1 3.14159265359
      name "range_back"
      lookupTable [
        0 0 0
        2 2000 0
      ]
    }
    DistanceSensor {
      rotation 0 0 1 1.57079632679
      name "range_left"
      lookupTable [
        0 0 0
        2 2000 0
      ]
    }
    DistanceSensor {
      name "range_front"
      lookupTable [
        0 0 0
        2 2000 0
      ]
    }
    Pose {
      translation 0 0 0.02
      rotation 0 1 0 -1.57079632679
      children [
        DistanceSensor {
          name "range_up"
          lookupTable [
            0 0 0
            2 2000 0
          ]
        }
      ]
    }
    GPS { }
    Gyro { }
    InertialUnit {
      name "inertial_unit"
    }
    LED {
      translation 0 0 -0.018
      name "color_led"
      gradual TRUE
      color [ ]
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.82 0.84 0.82
            emissiveColor 0 0 0
            transparency 0.12
          }
          geometry Cylinder {
            height 0.004
            radius 0.01735
          }
        }
      ]
    }
    Propeller {
      shaftAxis 0 0 1
      centerOfThrust 0.031 -0.031 0.008
      thrustConstants -4e-05 0
      torqueConstants 2.4e-06 0
      fastHelixThreshold 50
      device RotationalMotor {
        name "m1_motor"
        maxVelocity 600
        maxTorque 30
      }
      fastHelix Solid { }
      slowHelix Solid { }
    }
    Propeller {
      shaftAxis 0 0 1
      centerOfThrust -0.031 -0.031 0.008
      thrustConstants 4e-05 0
      torqueConstants 2.4e-06 0
      fastHelixThreshold 50
      device RotationalMotor {
        name "m2_motor"
        maxVelocity 600
        maxTorque 30
      }
      fastHelix Solid { }
      slowHelix Solid { }
    }
    Propeller {
      shaftAxis 0 0 1
      centerOfThrust -0.031 0.031 0.008
      thrustConstants -4e-05 0
      torqueConstants 2.4e-06 0
      fastHelixThreshold 50
      device RotationalMotor {
        name "m3_motor"
        maxVelocity 600
        maxTorque 30
      }
      fastHelix Solid { }
      slowHelix Solid { }
    }
    Propeller {
      shaftAxis 0 0 1
      centerOfThrust 0.031 0.031 0.008
      thrustConstants 4e-05 0
      torqueConstants 2.4e-06 0
      fastHelixThreshold 50
      device RotationalMotor {
        name "m4_motor"
        maxVelocity 600
        maxTorque 30
      }
      fastHelix Solid { }
      slowHelix Solid { }
    }
  ]
  boundingObject Cylinder {
    height 0.03
    radius 0.05
  }
  physics Physics {
    density -1
    mass 0.05
  }
}
