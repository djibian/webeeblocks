+static void read_physics_frame(WbRequest *r) {
+  const int end = request_get_size(r);
+  // Use memcpy for multibyte fields, which are unaligned after a message byte.
+  physics_frame_ready = false;
+  if (end - request_get_position(r) < 2 * (int)sizeof(int32_t))
+    goto malformed;
+  int32_t version, count;
+  memcpy(&version, request_read_data(r, sizeof(version)), sizeof(version));
+  memcpy(&count, request_read_data(r, sizeof(count)), sizeof(count));
+  if (version != WB_SUPERVISOR_PHYSICS_FRAME_VERSION || count < -1 ||
+      count > WB_SUPERVISOR_PHYSICS_FRAME_MAX_CONTACTS)
+    goto malformed;
+  if (count == -1) {
+    physics_frame_sent_id = 0;
+    return;
+  }
+
+  const int payload_size = 16 + 2 * (int)sizeof(int32_t) + (19 + 3 * count) * (int)sizeof(double) +
+                           count * (int)sizeof(int32_t);
+  if (end - request_get_position(r) < payload_size)
+    goto malformed;
+
+  WbSupervisorPhysicsFrame *f = &physics_frame;
+  f->contact_count = count;
+  memcpy(f->incarnation, request_read_data(r, sizeof(f->incarnation)), sizeof(f->incarnation));
+  memcpy(&f->supervisor_id, request_read_data(r, sizeof(f->supervisor_id)), sizeof(f->supervisor_id));
+  memcpy(&f->solid_id, request_read_data(r, sizeof(f->solid_id)), sizeof(f->solid_id));
+  memcpy(&f->time_ms, request_read_data(r, sizeof(f->time_ms)), sizeof(f->time_ms));
+  memcpy(f->position, request_read_data(r, sizeof(f->position)), sizeof(f->position));
+  memcpy(f->orientation, request_read_data(r, sizeof(f->orientation)), sizeof(f->orientation));
+  memcpy(f->velocity, request_read_data(r, sizeof(f->velocity)), sizeof(f->velocity));
+  for (int i = 0; i < count; ++i) {
+    WbContactPoint *contact = &f->contacts[i];
+    memcpy(contact->point, request_read_data(r, sizeof(contact->point)), sizeof(contact->point));
+    memcpy(&contact->node_id, request_read_data(r, sizeof(contact->node_id)), sizeof(contact->node_id));
+  }
+  physics_frame_ready = !robot_is_immediate_message() && physics_frame_sent_id > 0 &&
+                        f->solid_id == physics_frame_sent_id && self_node_ref && f->supervisor_id == self_node_ref->id;
+  physics_frame_sent_id = 0;
+  return;
+
+malformed:
+  physics_frame_sent_id = 0;
+  request_set_position(r, end);
+}
