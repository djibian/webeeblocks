+void WbSupervisorUtilities::invalidatePhysicsFrame() {
+  mPhysicsFrameTarget = 0;
+  mPhysicsFrameIncarnation.clear();
+  mPhysicsFrameTime = 0.0;
+}
+
+void WbSupervisorUtilities::writePhysicsFrame(WbDataStream &stream, double expectedTime) {
+  const int id = mPhysicsFrameTarget;
+  mPhysicsFrameTarget = 0;
+  if (id <= 0)
+    return;
+
+  stream << (quint16)0 << (quint8)C_SUPERVISOR_PHYSICS_FRAME << (qint32)WB_SUPERVISOR_PHYSICS_FRAME_VERSION;
+  const double time = WbSimulationState::instance()->time();
+  WbSolid *const solid = dynamic_cast<WbSolid *>(getProtoParameterNodeInstance(id, "wb_supervisor_physics_frame_request()"));
+  if (!solid || !mRobot->synchronization() || WbWorld::instance()->basicTimeStep() != 8.0 ||
+      time != expectedTime || time <= 0.0 || std::fmod(time, 8.0) != 0.0) {
+    stream << (qint32)-1;
+    return;
+  }
+
+  WbMatrix4 matrix(solid->matrix());
+  const WbVector3 position = matrix.translation();
+  const WbVector3 scale = matrix.scale();
+  const auto &points = solid->computedContactPoints(true);
+  const auto &solids = solid->computedSolidPerContactPoints();
+  const int count = points.size();
+  if (!(scale.x() > 0.0 && scale.y() > 0.0 && scale.z() > 0.0) || count != solids.size() ||
+      count > WB_SUPERVISOR_PHYSICS_FRAME_MAX_CONTACTS || std::any_of(solids.cbegin(), solids.cend(),
+        [](const WbSolid *contact) { return !contact; })) {
+    stream << (qint32)-1;
+    return;
+  }
+  matrix.scale(1.0 / scale.x(), 1.0 / scale.y(), 1.0 / scale.z());
+  if (mPhysicsFrameIncarnation.isEmpty() || time <= mPhysicsFrameTime)
+    mPhysicsFrameIncarnation = QUuid::createUuid().toRfc4122();
+  mPhysicsFrameTime = time;
+
+  stream << (qint32)count;
+  stream.writeRawData(mPhysicsFrameIncarnation.constData(), mPhysicsFrameIncarnation.size());
+  stream << (qint32)mRobot->uniqueId() << (qint32)id << time;
+  stream << position.x() << position.y() << position.z();
+  for (int row = 0; row < 3; ++row)
+    for (int column = 0; column < 3; ++column)
+      stream << matrix(row, column);
+
+  const WbVector3 linear = solid->relativeLinearVelocity();
+  const WbVector3 angular = solid->relativeAngularVelocity();
+  stream << linear.x() << linear.y() << linear.z() << angular.x() << angular.y() << angular.z();
+  for (int i = 0; i < count; ++i) {
+    const WbVector3 &point = points.at(i);
+    stream << point.x() << point.y() << point.z() << (qint32)solids.at(i)->uniqueId();
+  }
+}
