+
+bool wb_supervisor_physics_frame_read(WbSupervisorPhysicsFrame *frame) {
+  if (!frame)
+    return false;
+  robot_mutex_lock();
+  const bool ready = physics_frame_ready && wb_robot_get_step_duration() == 8 &&
+                     fabs(physics_frame.time_ms - 1000.0 * wb_robot_get_time()) < 1e-6;
+  physics_frame_ready = false;
+  if (ready)
+    *frame = physics_frame;
+  robot_mutex_unlock();
+  return ready;
+}
