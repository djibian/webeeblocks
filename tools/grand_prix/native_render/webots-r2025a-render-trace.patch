+qint64 WbPerformanceLog::traceStart() const {
+  if (!mRenderTraceEnabled || mRenderTraceFull)
+    return 0;
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+void WbPerformanceLog::traceStop(const char *section, qint64 start, double simulationTime) {
+  if (start == 0 || mRenderTraceFull)
+    return;
+  if (mRenderTrace.size() == mRenderTrace.capacity()) {
+    mRenderTraceFull = true;
+    return;
+  }
+  mRenderTrace.append({section, simulationTime, start, traceStart()});
+}
+
+void WbPerformanceLog::writeRenderTrace() const {
+  QFile file(mFileName + ".render.csv");
+  if (!file.open(QIODevice::WriteOnly | QIODevice::NewOnly | QIODevice::Text))
+    return;
+  QTextStream out(&file);
+  out << "# webots-render-trace-v1 complete=" << (mRenderTraceFull ? 0 : 1) << '\n';
+  out << "section,sim_ms,start_ns,end_ns\n";
+  for (const RenderSpan &span : mRenderTrace)
+    out << span.section << ',' << span.simulationTime << ',' << span.start << ',' << span.end << '\n';
+}
